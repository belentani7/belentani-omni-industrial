# BELENTANI Development Environment Configuration
# ================================================

# API Keys (Development)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Configuration (Development)
VITE_FIREBASE_AUTH_DOMAIN=belentani-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=belentani-dev
VITE_FIREBASE_STORAGE_BUCKET=belentani-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=987654321
VITE_FIREBASE_APP_ID=1:987654321:web:fedcba654321

# App Configuration
VITE_APP_NAME=BELENTANI DEV
VITE_APP_VERSION=1.0.0-dev
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false
VITE_ENABLE_STRIPE=true
VITE_ENABLE_PARTY_MODE=true

# Stripe Configuration (Test Mode)
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Analytics
VITE_GOOGLE_ANALYTICS_ID=G-DEV000000
VITE_SENTRY_DSN=

# Security
VITE_CSP_ENABLED=false
VITE_HTTPS_ONLY=false

# Performance
VITE_CACHE_STRATEGY=none
VITE_COMPRESSION=none

# Logging
VITE_LOG_LEVEL=debug
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
