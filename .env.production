# BELENTANI Production Environment Configuration
# ================================================

# API Keys
VITE_GEMINI_API_KEY=${GEMINI_API_KEY}
VITE_FIREBASE_API_KEY=${FIREBASE_API_KEY}

# Firebase Configuration
VITE_FIREBASE_AUTH_DOMAIN=belentani-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=belentani-prod
VITE_FIREBASE_STORAGE_BUCKET=belentani-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# App Configuration
VITE_APP_NAME=BELENTANI
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://belentani.com
VITE_API_URL=https://api.belentani.com

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=true
VITE_ENABLE_STRIPE=true
VITE_ENABLE_PARTY_MODE=true

# Stripe Configuration
VITE_STRIPE_PUBLIC_KEY=${STRIPE_PUBLIC_KEY}

# Analytics
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=${SENTRY_DSN}

# Security
VITE_CSP_ENABLED=true
VITE_HTTPS_ONLY=true

# Performance
VITE_CACHE_STRATEGY=aggressive
VITE_COMPRESSION=gzip

# Logging
VITE_LOG_LEVEL=error
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
